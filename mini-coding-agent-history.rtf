    return (\\\\n                    None, f\\\\\\"Invalid evidence type: \{evidence_value\}\\\\\\"\\\\n                )\\\\n\\\\n        # TodoItem\\\\n\\\\n        todos.append(\\\\n            TodoItem(\\\\n                id=index,\\\\n                content=content,\\\\n                kind=kind,\\\\n                requirement_ids=requirement_ids,\\\\n                required_evidence=required_evidence\\\\n            )\\\\n        )\\\\n\\\\n    return todos, None\\\\n\\\\n\\\\n# set_plan \u20174 \u20043 \u21069 \u30340 list[str]\u25913 \u20026 list[dict]\u65292 \u20854 \u20013 \u25658 \u24102 \u20102 \u26159 \u21542 \u38656 \u35201 \u39564 \u35777 \\\\ndef set_plan(\\\\n        state: AgentState,\\\\n        items: list[dict]\\\\n) -> ToolResult:\\\\n    \\\\\\"\\\\\\"\\\\\\"\\\\n    \u35774 \u32622 \u35745 \u21010 \\\\n    \\\\\\"\\\\\\"\\\\\\"\\\\n\\\\n    # Goal \u24517 \u39035 \u30830 \u23450 \\\\n    if not state.goal.locked:\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"Goal must be locked \\\\\\"\\\\n                \\\\\\"before creating a plan\\\\\\"\\\\n            )\\\\n        )\\\\n\\\\n    # Requirement\u24517 \u39035 \u30830 \u23450 \\\\n    if not state.requirements.locked:\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"Requirements must be locked \\\\\\"\\\\n                \\\\\\"before creating a plan\\\\\\"\\\\n            )\\\\n        )\\\\n    # \u24050 \u32463 \u26377 plan \\\\n    if state.plan.revision > 0:\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"An active plan already exists. \\\\\\"\\\\n                \\\\\\"Use replan instead of set_plan.\\\\\\"\\\\n            )\\\\n        )\\\\n\\\\n    # plan\u19981 \u33021 \u20026 \u31354 \\\\n    clean_items = [\\\\n        item\\\\n        for item in items\\\\n        if item\\\\n    ]\\\\n\\\\n    if not clean_items:\\\\n        return ToolResult.fail(\\\\n            error=\\\\\\"Plan cannot be empty.\\\\\\"\\\\n        )\\\\n\\\\n    # Plan v1\\\\n    todos, error = parse_plan_items(\\\\n        items=items\\\\n    )\\\\n    if error:\\\\n        return ToolResult.fail(\\\\n            error=error\\\\n        )\\\\n\\\\n    # \u23558 validation plan \u25918 \u22312 todos.append(...)\u20043 \u21518 \u65292 state.plan.revision = 1 \u20043 \u21069 \u35843 \u29992 \\\\n    validation = validate_plan(\\\\n        state=state,\\\\n        todos=todos\\\\n    )\\\\n\\\\n    if not validation.valid:\\\\n        return ToolResult.fail(\\\\n            error=format_plan_validation_errors(\\\\n                validation\\\\n            )\\\\n        )\\\\n\\\\n    state.plan.revision = 1\\\\n    state.plan.items = todos\\\\n\\\\n    return ToolResult(\\\\n        success=True,\\\\n        content=format_plan(state),\\\\n    )\\\\n\\\\ndef replan(\\\\n        state: AgentState,\\\\n        items: list[dict],\\\\n        reason: ReplanReason,\\\\n        explanation: str, # \u35299 \u37322 \\\\n        current_turn: int,\\\\n) -> ToolResult:\\\\n\\\\n    if (state.plan.replan_count >= MAX_REPLANS):\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"Maximum replanning limit \\\\\\"\\\\n                \\\\\\"has been reached. \\\\\\"\\\\n                \\\\\\"Do not keep replacing the plan. \\\\\\"\\\\n                \\\\\\"Resolve the current blocker or \\\\\\"\\\\n                \\\\\\"mark the task blocked.\\\\\\"\\\\n            )\\\\n        )\\\\n\\\\n    # \u24517 \u39035 \u26377 plan\\\\n    if state.plan.revision == 0:\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"No existing plan.\\\\\\"\\\\n                \\\\\\"Use set_plan first.\\\\\\"\\\\n            )\\\\n        )\\\\n\\\\n    # Goal / Requirements \u24517 \u39035 \u20445 \u25345 \u38145 \u23450 \\\\n    if not state.goal.locked:\\\\n        return ToolResult.fail(\\\\n            error=\\\\\\"Cannot replan without a locked goal.\\\\\\"\\\\n        )\\\\n\\\\n    if not state.requirements.locked:\\\\n        return ToolResult.fail(\\\\n            \\\\\\"Cannot replan without locked requirements.\\\\\\"\\\\n        )\\\\n\\\\n    explanation = explanation.strip()\\\\n\\\\n    if not explanation:\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"Replanning requires an explanation.\\\\\\"\\\\n            )\\\\n        )\\\\n\\\\n    # \u20808 \u26657 \u39564 \u24182 \u26500 \u36896 \u26032 \u35745 \u21010 \u65292 \u22833 \u36133 \u26102 \u19981 \u25913 \u21464 \u24403 \u21069 \u35745 \u21010 \u12290 \\\\n    if not items:\\\\n        return ToolResult.fail(\\\\n            \\\\\\"Replacement plan cannot be empty.\\\\\\"\\\\n        )\\\\n\\\\n    todos, error = parse_plan_items(\\\\n        items=items\\\\n    )\\\\n    if error:\\\\n        return ToolResult(\\\\n            error=error\\\\n        )\\\\n\\\\n    # \u22312 \u26377 todos\u21518 \u65292 \u31435 \u39532 \u26657 \u39564 todos\u26159 \u21542 \u26377 \u25928 \\\\n    # \u26032  Plan \u39564 \u35777 \u22833 \u36133 \u65292 \u19981 \u33021 \u25226 \u26087  Plan \u25630 \u22351 \u12290 \\\\n    validation = validate_plan(\\\\n        state=state,\\\\n        todos=todos\\\\n    )\\\\n\\\\n    if not validation.valid:\\\\n        return ToolResult.fail(\\\\n            error=format_plan_validation_errors(\\\\n                validation\\\\n            )\\\\n        )\\\\n\\\\n    # \u19981 \u20801 \u35768 \u23436 \u20840 \u30456 \u21516 \u30340 plan\\\\n    old_contents = [\\\\n        item.content\\\\n        for item in state.plan.items\\\\n    ]\\\\n\\\\n    if old_contents == [item.content for item in todos]:\\\\n        return ToolResult.fail(\\\\n            error=(\\\\n                \\\\\\"Replacement plan is identical to the current plan.\\\\\\"\\\\n            )\\\\n        )\\\\n\\\\n    # \u20445 \u23384 \u26087 plan\\\\n    old_revision = state.plan.revision\\\\n    snapshot = PlanSnapshot(\\\\n        revision=old_revision,\\\\n        items = deepcopy(\\\\n            state.plan.items\\\\n        ),\\\\n        status=PlanStatus.SUPERSEDED,\\\\n        reason=(\\\\n            f\\\\\\"\{reason.value\}\\\\\\"\\\\n            f\\\\\\"\{explanation\}\\\\\\"\\\\n        ),\\\\n        created_turn=0,\\\\n        superseded_turn=current_turn\\\\n    )\\\\n    new_revision = old_revision + 1\\\\n    state.plan.history.append(snapshot)\\\\n    state.plan.revision = new_revision\\\\n    state.plan.items = todos\\\\n    state.plan.replan_count += 1\\\\n    # \u28165 \u31354 \u25152 \u26377 \u30340 failure streak\\\\n    clear_failure_streak(state=state)\\\\n    record_progress(state=state, turn=current_turn)\\\\n\\\\n    return ToolResult.ok(\\\\n        content=(\\\\n            f\\\\\\"Plan revision \\\\\\"\\\\n            f\\\\\\"\{old_revision\} was superseded.\\\\\\"\\\\n            f\\\\\\"Created plan revision \\\\\\"\\\\n            f\\\\\\"\{new_revision\}.\\\\\\"\\\\n        )\\\\n    )\\\\n\\\\ndef update_task(\\\\n        state: AgentState,\\\\n        metrics: AgentMetrics,\\\\n        task_id: int,\\\\n        status: str,\\\\n        note: str | None = None,\\\\n) -> ToolResult:\\\\n\\\\n    # 1. Parse status\\\\n\\\\n    try:\\\\n        target_status = TaskStatus(status)\\\\n    except ValueError:\\\\n        return ToolResult.fail(\\\\n            error=f\\\\\\"Invalid task status: \{status\}\\\\\\"\\\\n        )\\\\n\\\\n    # 2.Find task\\\\n    todo = next(\\\\n        (\\\\n            item \\\\n            for item in state.plan.items\\\\n            if item.id == task_id\\\\n        ),\\\\n        None\\\\n    )\\\\n\\\\n    if todo is None:\\\\n        return ToolResult.fail(\\\\n            error=f\\\\\\"Task \{task_id\} does not exist.\\\\\\"\\\\n        )\\\\n\\\\n    # 3.Validate\\\\n    validation = validate_task_transition(\\\\n        state=state,\\\\n        todo=todo,\\\\n        target=target_status,\\\\n    )\\\\n\\\\n    if not validation.allowed:\\\\n\\\\n        return ToolResult.fail(\\\\n            error=validation.error\\\\n            or \\\\\\"Invalid task transition.\\\\\\"\\\\n        )\\\\n\\\\n    # 4. Commit\\\\n    old_status = todo.status\\\\n    todo.status = target_status\\\\n    if note is not None:\\\\n        todo.note = note.strip()\\\\n\\\\n    #5 Progress\\\\n    record_progress(\\\\n        state=state,\\\\n        turn=metrics.model_turns,\\\\n    )\\\\n    return ToolResult.ok(\\\\n        content=(\\\\n            f\\\\\\"Task \{task_id\} updated: \\\\\\"\\\\n            f\\\\\\"\{old_status.value\} \\\\\\"\\\\n            f\\\\\\"-> \{target_status.value\}.\\\\\\"\\\\n        )\\\\n    )\\\\n\\\\n\\\\ndef get_plan(\\\\n        state: AgentState\\\\n) -> ToolResult:\\\\n    \\\\\\"\\\\\\"\\\\\\"\\\\n    \u33719 \u21462 \u35745 \u21010 \\\\n    \\\\\\"\\\\\\"\\\\\\"\\\\n    return ToolResult(\\\\n        success=True,\\\\n        content=format_plan(state)\\\\n    )\\\\n\\\\n# \u19978 \u19979 \u25991 \u28210 \u26579 \u20989 \u25968 \u24050 \u25286 \u20998 \u21040  .runtime_context\u65292 \\\\n# \u20572 \u28382 /\u36827 \u23637 \u21028 \u23450 \u20989 \u25968 \u24050 \u25286 \u20998 \u21040  .stagnation\u65292 \\\\n# \u22312 \u25991 \u20214 \u26411 \u23614 \u32479 \u19968 \u37325 \u26032 \u23548 \u20986 \u65292 \u20445 \u25345 \u23545 \u22806 \u25509 \u21475 \u19981 \u21464 \u12290 \\\\n\\\\n\\\\ndef validate_plan(\\\\n        state: AgentState,\\\\n        todos: list[TodoItem]\\\\n) -> PlanValidationResult:\\\\n    '''\\\\n    \u23545 \u24403 \u21069 \u35745 \u21010 (todos)\u36827 \u34892 \u25972 \u20307 \u32467 \u26500 \u26657 \u39564 \u65292 \u26159  Plan \u23618 \u26657 \u39564 \u30340 \u32479 \u19968 \u20837 \u21475 \u12290 \\\\n\\\\n    \u26657 \u39564 \u20869 \u23481 \u65288 \u25353 \u39034 \u24207 \u25191 \u34892 \u65289 \u65306 \\\\n    1. \u35745 \u21010 \u38271 \u24230 \u65306 \u26465 \u30446 \u25968 \u19981 \u24471 \u23569 \u20110  MIN_PLAN_ITEMS\u65292 \u20063 \u19981 \u24471 \u22810 \u20110  MAX_PLAN_ITEMS\u65307 \\\\n    2. \u37325 \u22797 \u26465 \u30446 \u65306 \u25353  normalize_plan_content \u35268 \u33539 \u21270 \u21518 \u30340 \u20869 \u23481 \u21435 \u37325 \u65292 \\\\n       \u20986 \u29616 \u37325 \u22797 \u21017 \u25253 \u21578  duplicate_plan_item\u65307 \\\\n    3. \u22996 \u27966 \u32473 \u21508 \u19987 \u39033 \u26657 \u39564 \u23376 \u20989 \u25968 \u65292 \u25226 \u21457 \u29616 \u30340 \u38382 \u39064 \u32047 \u21152 \u21040 \u21516 \u19968 \u20010  issues \u21015 \u34920 \u65306 \\\\n       - validate_plan_verification\u65306 must_verify \u38656 \u27714 \u26159 \u21542 \u26377 \u23545 \u24212 \u30340 \u39564 \u35777 \u35777 \u25454 \u65307 \\\\n       - validate_requirement_references\u65306 todo \u24341 \u29992 \u30340  requirement id \u26159 \u21542 \u23384 \u22312 \u65307 \\\\n       - validate_requirement_mapping\u65306 requirement.kind \u19982  todo.kind \u26159 \u21542 \u21305 \u37197 \u65307 \\\\n       - validate_requirement_coverage\u65306 must_change / must_verify \u38656 \u27714 \u26159 \u21542 \u34987 \u35206 \u30422 \u12290 \\\\n\\\\n    Args:\\\\n        state: \u24403 \u21069  Agent \u29366 \u24577 \u65292 \u25552 \u20379  state.requirements \u29992 \u20110 \u38656 \u27714 \u30456 \u20851 \u26657 \u39564 \u12290 \\\\n        todos: \u24453 \u26657 \u39564 \u30340 \u35745 \u21010 \u26465 \u30446 \u21015 \u34920 \u12290 \\\\n\\\\n    Returns:\\\\n        PlanValidationResult\u65306 valid \u34920 \u31034 \u26159 \u21542 \u23384 \u22312 \u36829 \u35268 \u65292 \\\\n        issues \u20026 \u25152 \u26377 \u26657 \u39564 \u38382 \u39064 \u30340 \u27719 \u24635 \u65288 \u26080 \u38382 \u39064 \u26102 \u20026  valid=True \u19988 \u31354 \u21015 \u34920 \u65289 \u12290 \\\\n    '''\\\\n\\\\n    issues: list[PlanValidationIssue] = []\\\\n    # 1. plan \u38271 \u24230 \u65306 \u36807 \u30701 \u65288 \u23569 \u20110  MIN_PLAN_ITEMS\u65289 \\\\n    if len(todos) < MIN_PLAN_ITEMS:\\\\n        issues.append(\\\\n            PlanValidationIssue(\\\\n                code=\\\\\\"plan_too_short\\\\\\",\\\\n                message=(\\\\n                    \\\\\\"A multi-step plan should contain \\\\\\"\\\\n                    f\\\\\\"at least \{MIN_PLAN_ITEMS\} times.\\\\\\"\\\\n                )\\\\n            )\\\\n        )\\\\n\\\\n    # 1. plan \u38271 \u24230 \u65306 \u36807 \u38271 \u65288 \u22810 \u20110  MAX_PLAN_ITEMS\u65289 \\\\n    if len(todos) > MAX_PLAN_ITEMS:\\\\n        issues.append(\\\\n            PlanValidationIssue(\\\\n                code=\\\\\\"plan_too_long\\\\\\",\\\\n                message=(\\\\n                    f\\\\\\"Plan contains \{len(todos)\} items.\\\\\\"\\\\n                    f\\\\\\"Maximum allowed is \\\\\\"\\\\n                    f\\\\\\"\{MAX_PLAN_ITEMS\}.\\\\\\"\\\\n                )\\\\n\\\\n            )\\\\n        )\\\\n\\\\n    # 2.\u37325 \u22797  todo\\\\n    seen: set[str] = set()\\\\n\\\\n    for todo in todos:\\\\n        normalized = normalize_plan_content(\\\\n            todo.content\\\\n        )\\\\n        if normalized in seen:\\\\n            issues.append(\\\\n                PlanValidationIssue(\\\\n                    code=\\\\\\"duplicate_plan_item\\\\\\",\\\\n                    message=(\\\\n                        \\\\\\"plan contains duplicate item: \\\\\\"\\\\n                        f\\\\\\"\{todo.content\}\\\\\\"\\\\n                    )\\\\n                )\\\\n            )\\\\n        seen.add(normalized)\\\\n\\\\n\\\\n    validate_plan_verification(\\\\n        state=state,\\\\n        todos=todos,\\\\n        issues=issues\\\\n    )\\\\n\\\\n    validate_requirement_references(\\\\n        state=state,\\\\n        todos=todos,\\\\n        issues=issues\\\\n    )\\\\n\\\\n    validate_requirement_mapping(\\\\n        state=state,\\\\n        todos=todos,\\\\n        issues=issues\\\\n    )\\\\n\\\\n    validate_requirement_coverage(\\\\n        state=state,\\\\n        todos=todos,\\\\n        issues=issues\\\\n    )\\\\n\\\\n    return PlanValidationResult(\\\\n        valid= not issues,\\\\n        issues=issues\\\\n    )\\\\n\\\\ndef normalize_plan_content(\\\\n        content: str,\\\\n) -> str:\\\\n    '''\\\\n    \u26631 \u20934 \u21270 \u20989 \u25968 \u65292 \u23558 plan\u26684 \u24335 \u21270 \\\\n    '''\\\\n    return \\\\\\" \\\\\\".join(\\\\n        content.strip()\\\\n        .lower()\\\\n        .split()\\\\n    )\\\\n\\\\n\\\\ndef format_plan_validation_errors(\\\\n        result: PlanValidationResult\\\\n) -> str:\\\\n\\\\n    '''\\\\n    \u23558 Plan_validation\u26684 \u24335 \u21270 \\\\n    '''\\\\n    lines = [\\\\n        \\\\\\"Plan validation failed: \\\\\\"\\\\n    ]\\\\n\\\\n    for issue in result.issues:\\\\n        lines.append(\\\\n            f\\\\\\"-[\{issue.code\}] \\\\\\"\\\\n            f\\\\\\"\{issue.message\}\\\\\\"\\\\n        )\\\\n\\\\n    return \\\\\\"\\\\\\\\n\\\\\\".join(lines)\\\\n\\\\n\\\\ndef validate_plan_verification(\\\\n        state: AgentState,\\\\n        todos: list[TodoItem],\\\\n        issues: list[PlanValidationIssue]\\\\n) -> None:\\\\n    '''\\\\n    \u26657 \u39564 \u35745 \u21010 \u26159 \u21542 \u35206 \u30422 \u20102 \u25152 \u26377  must_verify \u38656 \u27714 \u30340 \u39564 \u35777 \u35777 \u25454 \u12290 \\\\n\\\\n    \u36923 \u36753 \u65306 \\\\n    - \u25910 \u38598 \u35745 \u21010 \u20013 \u25152 \u26377  todo \u22768 \u26126 \u30340  required_evidence\u65292 \u24471 \u21040 \u35745 \u21010 \u23454 \u38469 \u25552 \u20379 \u30340 \u35777 \u25454 \u38598 \u21512 \u65307 \\\\n    - \u36890 \u36807  verification_evidence_map \u23558 \u38656 \u27714 \u30340  verifier \u26144 \u23556 \u20026 \u23545 \u24212 \u30340  EvidenceType\u65306 \\\\n      \\\\\\"test\\\\\\" -> TESTS_PASSED\u65292 \\\\\\"diff\\\\\\" -> DIFF_INSPECTED\u65307 \\\\n    - \u23545 \u27599 \u20010  kind \u20026  MUST_VERIFY \u30340  requirement\u65306 \\\\n      - \u33509 \u20854  verifier \u26242 \u26080 \u23545 \u24212 \u30340  EvidenceType\u65288 \u22914  build / syntax\u65289 \u65292 \\\\n        \u24403 \u21069 \u19981 \u25903 \u25345  Plan \u23618 \u26657 \u39564 \u65292 \u30452 \u25509 \u36339 \u36807 \u65307 \\\\n      - \u33509 \u25152 \u38656 \u35777 \u25454 \u19981 \u22312 \u35745 \u21010 \u25552 \u20379 \u30340 \u35777 \u25454 \u38598 \u21512 \u20013 \u65292 \u25253 \u21578  missing_verification_step\u12290 \\\\n\\\\n    Args:\\\\n        state: \u24403 \u21069  Agent \u29366 \u24577 \u65292 \u25552 \u20379  state.requirements \u38656 \u27714 \u21015 \u34920 \u12290 \\\\n        todos: \u24453 \u26657 \u39564 \u30340 \u35745 \u21010 \u26465 \u30446 \u21015 \u34920 \u65292 \u35835 \u21462 \u20854  required_evidence \u23383 \u27573 \u12290 \\\\n        issues: \u36755 \u20986 \u21442 \u25968 \u65292 \u21457 \u29616 \u30340 \u38382 \u39064 \u20250  append \u21040 \u27492 \u21015 \u34920 \u65288 \u21407 \u22320 \u20462 \u25913 \u65292 \u26080 \u36820 \u22238 \u20540 \u65289 \u12290 \\\\n\\\\n    Returns:\\\\n        None\u65306 \u26657 \u39564 \u32467 \u26524 \u36890 \u36807  issues \u21015 \u34920 \u36820 \u22238 \u12290 \\\\n    '''\\\\n    \\\\n    # 3. Verification coverage \u39564 \u35777 \u33539 \u22260 \u65292 Requirement -> plan coverage \u35745 \u21010 \u30340 \u35206 \u30422 \u33539 \u22260 \u26159 \u21542 \u33021 \u35206 \u30422 \u38656 \u27714 \\\\n    plan_evidence = \{\\\\n        todo.required_evidence\\\\n        for todo in todos\\\\n        if todo.required_evidence is not None\\\\n    \}\\\\n\\\\n    verification_evidence_map = \{\\\\n        \\\\\\"test\\\\\\": EvidenceType.TESTS_PASSED,\\\\n        \\\\\\"diff\\\\\\": EvidenceType.DIFF_INSPECTED\\\\n    \}\\\\n\\\\n    for requirement in state.requirements.items:\\\\n        if (requirement.kind != RequirementKind.MUST_VERIFY):\\\\n            continue\\\\n\\\\n        expected_evidence = (\\\\n            verification_evidence_map.get(requirement.verifier)\\\\n        )\\\\n        # \u24403 \u21069  EvidenceType\u26242 \u26102 \u19981 \u25903 \u25345 \\\\n        # build /syntax \u30340  Plan-level \u39564 \u35777 \\\\n        if expected_evidence is None:\\\\n            continue\\\\n        \\\\n        if expected_evidence not in plan_evidence:\\\\n            issues.append(\\\\n                PlanValidationIssue(\\\\n                    code=\\\\\\"missing_verification_step\\\\\\",\\\\n                    message=(\\\\n                        f\\\\\\"Requirement \\\\\\"\\\\n                        f\\\\\\"\{requirement.id\} requires\\\\\\"\\\\n                        f\\\\\\"'\{requirement.verifier\}' \\\\\\"\\\\n                        \\\\\\"verification, but the plan \\\\\\"\\\\n                        \\\\\\"does not include the required \\\\\\"\\\\n                        \\\\\\"verification evidence.\\\\\\"\\\\n                    )\\\\n                )\\\\n            )\\\\n\\\\ndef validate_requirement_references(\\\\n        state: AgentState,\\\\n        todos: list[TodoItem],\\\\n        issues: list[PlanValidationIssue]\\\\n) -> None:\\\\n    '''\\\\n    \u26657 \u39564  todos \u20013 \u24341 \u29992 \u30340  requirement id \u26159 \u21542 \u30495 \u23454 \u23384 \u22312 \u12290 \\\\n\\\\n    \u36923 \u36753 \u65306 \\\\n    - \u20808 \u20174  state.requirements.items \u25910 \u38598 \u25152 \u26377 \u21512 \u27861 \u30340  requirement id\u65307 \\\\n    - \u36941 \u21382 \u27599 \u20010  todo \u30340  requirement_ids\u65292 \\\\n      \u33509 \u26576 \u20010  id \u19981 \u22312 \u21512 \u27861 \u38598 \u21512 \u20013 \u65292 \u21017 \u25253 \u21578  unknown_requirement\u12290 \\\\n\\\\n    \u27880 \u24847 \u65306 \u26412 \u20989 \u25968 \u21482 \u36127 \u36131 \'93\u24341 \u29992 \u26159 \u21542 \u26377 \u25928 \'94\u65292 \\\\n    \u24341 \u29992 \u31867 \u22411 \u26159 \u21542 \u21305 \u37197 \u30001  validate_requirement_mapping \u36127 \u36131 \u12290 \\\\n\\\\n    Args:\\\\n        state: \u24403 \u21069  Agent \u29366 \u24577 \u65292 \u25552 \u20379  state.requirements \u38656 \u27714 \u21015 \u34920 \u12290 \\\\n        todos: \u24453 \u26657 \u39564 \u30340 \u35745 \u21010 \u26465 \u30446 \u21015 \u34920 \u65292 \u35835 \u21462 \u20854  requirement_ids \u23383 \u27573 \u12290 \\\\n        issues: \u36755 \u20986 \u21442 \u25968 \u65292 \u21457 \u29616 \u30340 \u38382 \u39064 \u20250  append \u21040 \u27492 \u21015 \u34920 \u65288 \u21407 \u22320 \u20462 \u25913 \u65292 \u26080 \u36820 \u22238 \u20540 \u65289 \u12290 \\\\n\\\\n    Returns:\\\\n        None\u65306 \u26657 \u39564 \u32467 \u26524 \u36890 \u36807  issues \u21015 \u34920 \u36820 \u22238 \u12290 \\\\n    '''\\\\n    valid_requirement_ids = \{\\\\n        requirement.id\\\\n        for requirement in state.requirements.items\\\\n    \}\\\\n\\\\n    for todo in todos:\\\\n        for requirement_id in todo.requirement_ids:\\\\n            if requirement_id not in valid_requirement_ids:\\\\n                issues.append(\\\\n                    PlanValidationIssue(\\\\n                        code=\\\\\\"unknown_requirement\\\\\\",\\\\n                        message=(\\\\n                            f\\\\\\"Todo \{todo.id\} \\\\\\"\\\\n                            \\\\\\"references unknown requirement \\\\\\"\\\\n                            f\\\\\\"\{requirement_id\}.\\\\\\" \\\\n                        )\\\\n                    )\\\\n                )\\\\n\\\\ndef validate_requirement_mapping(\\\\n        state: AgentState,\\\\n        todos: list[TodoItem],\\\\n        issues: list[PlanValidationIssue]\\\\n) -> None:\\\\n    '''\\\\n    \u26657 \u39564  requirement.kind \u19982 \u24341 \u29992 \u23427 \u30340  todo.kind \u26159 \u21542 \u19968 \u19968 \u23545 \u24212 \u12290 \\\\n\\\\n    \u23545 \u24212 \u20851 \u31995 \u65306 \\\\n    MUST_CHANGE   -> IMPLEMENTATION\\\\n    MUST_VERIFY   -> VERIFICATION\\\\n    MUST_NOT_MODIFY -> Runtime Guard\u65288 \u19981 \u24212 \u34987 \u25351 \u27966 \u32473 \u20219 \u20309  todo\u65289 \\\\n    SOFT_CONSTRAINT -> Context / Model Responsibility\u65288 \u19981 \u22312 \u27492 \u26657 \u39564 \u65289 \\\\n\\\\n    \u36923 \u36753 \u65306 \\\\n    - \u24314 \u31435  requirement id -> requirement \u30340 \u32034 \u24341 \u65307 \\\\n    - \u36941 \u21382 \u27599 \u20010  todo \u24341 \u29992 \u30340  requirement\u65306 \\\\n      - \u24341 \u29992 \u19981 \u23384 \u22312 \u30340  id \u26102 \u36339 \u36807 \u65288 \u24050 \u30001  validate_requirement_references \u22788 \u29702 \u65289 \u65307 \\\\n      - MUST_CHANGE \u21364 \u23545 \u24212 \u38750  implementation \u30340  todo\u65292 \u25253 \u21578  requirement_kind_mismatch\u65307 \\\\n      - MUST_VERIFY \u21364 \u23545 \u24212 \u38750  verification \u30340  todo\u65292 \u25253 \u21578  requirement_kind_mismatch\u65307 \\\\n      - MUST_NOT_MODIFY \u34987 \u24341 \u29992 \u26102 \u65292 \u25253 \u21578  constraint_requirement_reference\u65307 \\\\n      - SOFT_CONSTRAINT \u19981 \u20570 \u31867 \u22411 \u26657 \u39564 \u12290 \\\\n\\\\n    Args:\\\\n        state: \u24403 \u21069  Agent \u29366 \u24577 \u65292 \u25552 \u20379  state.requirements \u38656 \u27714 \u21015 \u34920 \u12290 \\\\n        todos: \u24453 \u26657 \u39564 \u30340 \u35745 \u21010 \u26465 \u30446 \u21015 \u34920 \u65292 \u35835 \u21462 \u20854  kind \u19982  requirement_ids \u23383 \u27573 \u12290 \\\\n        issues: \u36755 \u20986 \u21442 \u25968 \u65292 \u21457 \u29616 \u30340 \u38382 \u39064 \u20250  append \u21040 \u27492 \u21015 \u34920 \u65288 \u21407 \u22320 \u20462 \u25913 \u65292 \u26080 \u36820 \u22238 \u20540 \u65289 \u12290 \\\\n\\\\n    Returns:\\\\n        None\u65306 \u26657 \u39564 \u32467 \u26524 \u36890 \u36807  issues \u21015 \u34920 \u36820 \u22238 \u12290 \\\\n    '''\\\\n\\\\n    requirement_by_id = \{\\\\n        requirement.id: requirement\\\\n        for requirement in state.requirements.items\\\\n    \}\\\\n\\\\n    for todo in todos:\\\\n        for requirement_id in todo.requirement_ids:\\\\n            requirement = requirement_by_id.get(requirement_id)\\\\n            # unknown requirement\\\\n            # \u21069 \u38754 \u24050 \u22788 \u29702 \\\\n            if requirement is None:\\\\n                continue\\\\n\\\\n            # MUST_CHANGE\\\\n            if (\\\\n                requirement.kind == RequirementKind.MUST_CHANGE \\\\n                and todo.kind != TodoKind.IMPLEMENTATION\\\\n            ):\\\\n                issues.append(\\\\n                    PlanValidationIssue(\\\\n                        code=\\\\\\"requirement_kind_mismatch\\\\\\",\\\\n                        message=(\\\\n                            f\\\\\\"Requirement \\\\\\"\\\\n                            f\\\\\\"\{requirement.id\} is must_change\\\\\\"\\\\n                            \\\\\\", but todo \{todo.id\} is not\\\\\\"\\\\n                            \\\\\\" an implementation task.\\\\\\"\\\\n                        )\\\\n                    )\\\\n                )\\\\n\\", \\"path\\": \\"src/mini_coding_agent/planning.py\\"\}",\
